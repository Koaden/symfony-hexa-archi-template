# Injected into the php container by compose.yaml.
# Generate a new secret for production: openssl rand -hex 32
APP_SECRET=bfd6c62025f663d5829aa00a4e6fa15a
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# Used by the db container at initialization.
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Used by the php container (Doctrine).
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"

# Production
SERVER_NAME=localhost
