# Injected into the php container by compose.yaml.
# Dev only. Production needs its own value: openssl rand -hex 32 (make prod refuses this one).
APP_SECRET=dev-only-secret-change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# Used by the db container at initialization.
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Used by the php container (Doctrine).
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?serverVersion=18&charset=utf8"

# Optional: Sentry DSN (empty disables error reporting).
SENTRY_DSN=

# Production
SERVER_NAME=localhost

# Dev: host ports (change them to run several projects side by side).
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=5432
ADMINER_PORT=8080

# Optional off-site backups (make prod.offsite): rclone remote path.
OFFSITE_REMOTE=
